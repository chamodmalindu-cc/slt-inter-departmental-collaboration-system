# Frontend Environment Variables Template
VITE_API_BASE_URL=http://localhost:5000

# Microsoft Entra ID (Azure AD) Client Settings
# (Obtain Client ID and Tenant ID from your Microsoft Entra App Registration)
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_REDIRECT_URI=http://127.0.0.1:5173/login
VITE_ENTRA_API_SCOPE=openid profile email User.Read
