# Root .gitignore for SLT Project Communication System

# Environment variables & secrets
.env
.env.*
!.env.example
*.local

# Node / Frontend
**/node_modules/
**/dist/
**/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# .NET / Backend
**/bin/
**/obj/
**/uploads/
*.user
*.suo
*.userosscache
*.sln.docstates

# IDE / Editors
.vs/
.vscode/*
!.vscode/extensions.json
.idea/

# OS Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Environment-specific application settings
backend/appsettings.json
backend/appsettings.Production.json
