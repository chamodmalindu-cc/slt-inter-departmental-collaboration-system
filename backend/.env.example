# ==============================================================================
# SLT Inter-Departmental Collaboration System - Environment Configuration
# Copy this file to '.env' and populate with your environment-specific secrets.
# NEVER commit the actual '.env' file with production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=slt_collab_db
DB_USER=postgres
DB_PASSWORD=your_strong_postgres_password_here
DB_SSL_MODE=Prefer

# ------------------------------------------------------------------------------
# 2. JWT Authentication Secrets
# ------------------------------------------------------------------------------
# Must be a cryptographically random string with at least 32 characters (256 bits).
# In production, generate using: openssl rand -base64 48
JWT_SECRET_KEY=ReplaceWithAStrongCryptographicRandomSecretKeyMinimum32Chars!
JWT_ISSUER=SltCommunicationSystem
JWT_AUDIENCE=SltCommunicationSystemClient
JWT_EXPIRY_MINUTES=480

# ------------------------------------------------------------------------------
# 3. ASP.NET Core Runtime Settings
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# ------------------------------------------------------------------------------
# 4. Production Allowed CORS Origins (Comma-separated for multiple hosts)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 5. Microsoft Entra ID (Azure Active Directory) Integration
# (Configure with details from your Microsoft Entra App Registration)
# ------------------------------------------------------------------------------
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_AUDIENCE=api://00000000-0000-0000-0000-000000000000
ENTRA_INSTANCE=https://login.microsoftonline.com/
ENTRA_REDIRECT_URI=http://127.0.0.1:5173/login
